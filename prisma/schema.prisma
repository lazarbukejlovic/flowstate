generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  EDITOR
  VIEWER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships  Membership[]
  ownedTasks   Task[]       @relation("TaskOwner")
  comments     Comment[]
  activityLogs ActivityLog[]
}

model Organization {
  id         String   @id @default(cuid())
  clerkOrgId String?  @unique
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  memberships Membership[]
  workspaces  Workspace[]
}

model Membership {
  id        String   @id @default(cuid())
  role      Role     @default(VIEWER)
  userId    String
  orgId     String
  createdAt DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
}

model Workspace {
  id          String   @id @default(cuid())
  title       String
  summary     String?  @db.Text
  orgId       String?
  createdById String?
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization  Organization?  @relation(fields: [orgId], references: [id])
  meetingSource MeetingSource?
  tasks         Task[]
  decisions     Decision[]
  activityLogs  ActivityLog[]

  @@index([orgId])
  @@index([createdById])
}

model MeetingSource {
  id           String   @id @default(cuid())
  workspaceId  String   @unique
  meetingTitle String?
  transcript   String   @db.Text
  meetingUrl   String?
  processedAt  DateTime @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  risks     Risk[]
  followUps FollowUp[]
}

model Task {
  id           String     @id @default(cuid())
  workspaceId  String
  title        String
  description  String?    @db.Text
  ownerName    String?
  ownerId      String?
  deadline     DateTime?
  priority     Priority   @default(MEDIUM)
  status       TaskStatus @default(TODO)
  sourceQuote  String?    @db.Text
  aiConfidence Int?
  aiReason     String?    @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User?     @relation("TaskOwner", fields: [ownerId], references: [id])
  comments  Comment[]

  @@index([workspaceId])
  @@index([status])
  @@index([ownerId])
}

model Decision {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  context     String?  @db.Text
  ownerName   String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Risk {
  id              String   @id @default(cuid())
  meetingSourceId String
  title           String
  severity        Priority @default(MEDIUM)
  mitigation      String?  @db.Text
  createdAt       DateTime @default(now())

  meetingSource MeetingSource @relation(fields: [meetingSourceId], references: [id], onDelete: Cascade)
}

model FollowUp {
  id              String   @id @default(cuid())
  meetingSourceId String
  title           String
  ownerName       String?
  completed       Boolean  @default(false)
  createdAt       DateTime @default(now())

  meetingSource MeetingSource @relation(fields: [meetingSourceId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  actorName   String?
  action      String
  detail      String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id])

  @@index([workspaceId])
}

model Comment {
  id         String   @id @default(cuid())
  taskId     String
  userId     String?
  authorName String?
  content    String   @db.Text
  createdAt  DateTime @default(now())

  task Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])
}
